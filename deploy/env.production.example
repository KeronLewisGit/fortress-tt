APP_NAME="Fortress Security Services"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.fortress.tt
APP_TIMEZONE=America/Port_of_Spain
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_fortress
DB_USERNAME=u000000000_fortress
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Hostinger mailbox (hPanel → Emails). Use the mailbox you created.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=recruitment@fortress.tt
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=recruitment@fortress.tt
MAIL_FROM_NAME="${APP_NAME}"
